# claude-call environment variable overrides
# All variables are optional — defaults use ~/.claude-call/ paths
# Keep this file checked in; never put real values here.
# Copy to .env and uncomment only the variables you need to override.

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Path to the credentials file (KEY=VALUE pairs for Twilio/voice-engine secrets)
# Default: ~/.claude-call/credentials
# CLAUDE_CALL_CREDENTIALS=~/.claude-call/credentials

# Path to the call-store file (NDJSON log of completed calls)
# Default: ~/.claude-call/calls.ndjson
# CLAUDE_CALL_STORE=~/.claude-call/calls.ndjson

# Path to the server log file (NDJSON event log)
# Default: ~/.claude-call/log.ndjson
# CLAUDE_CALL_LOG=~/.claude-call/log.ndjson

# Path to the fire-queue directory (drop .json files here to trigger calls)
# Default: ~/.claude-call/fire-queue
# CLAUDE_CALL_FIRE_QUEUE=~/.claude-call/fire-queue

# Path to the inbound-armed flag file (presence of this file arms inbound mode)
# Default: ~/.claude-call/inbound-armed
# CLAUDE_CALL_INBOUND_FLAG=~/.claude-call/inbound-armed

# Path to the inbound messages file (NDJSON of inbound caller transcripts)
# Default: ~/.claude-call/messages.ndjson
# CLAUDE_CALL_MESSAGES=~/.claude-call/messages.ndjson

# ---------------------------------------------------------------------------
# Timeouts
# ---------------------------------------------------------------------------

# Maximum duration of an outbound call in milliseconds before it is forcibly ended
# Default: 300000 (5 minutes)
# CLAUDE_CALL_TIMEOUT_MS=300000
