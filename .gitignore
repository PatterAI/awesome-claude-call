# claude-call .gitignore
.DS_Store
*.log
node_modules/
dist/
.claude/
CLAUDE.md
# server/dist/ ships with the plugin (Claude Code copies the repo verbatim into its cache):
!server/dist/
!server/dist/**
.coverage/
.idea/
.vscode/
*.bats.tmp
tests/.tmp/

docs/superpowers/


.env
.env.*
!.env.example

# Stale root-level lock file (no root package.json)
/package-lock.json

# Credential and key files
*.pem
*.key
*.p12
*.pfx

# OS / editor
Thumbs.db
*.swp